# ReviewDesk configuration.
#
# Two shapes are supported and they never mix:
#   - managed (Vercel or any production host): postgres:// + STORAGE_DRIVER=s3
#   - local development: pglite:// + STORAGE_DRIVER=filesystem
# The dev drivers are refused when NODE_ENV=production or VERCEL=1.

# ---------------------------------------------------------------- required

# At least 16 characters, 8 distinct, no common word. The only human credential.
ADMIN_PASSWORD=replace-with-a-long-random-passphrase

# --------------------------------------------------- managed: PostgreSQL

# Use the POOLED connection string, not the direct one: a serverless platform
# opens one connection per warm instance and a direct endpoint runs out.
#   Neon     : postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/reviewdesk?sslmode=require
#   Supabase : postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@host.example/reviewdesk?sslmode=require
# DATABASE_POOL_MAX=1              # connections per instance; raise only behind a pooler
# DATABASE_SSL=true                # inferred from sslmode / hostname
# DATABASE_STATEMENT_TIMEOUT_MS=8000
# RUN_MIGRATIONS_ON_BOOT=true      # set to 0 and run `npm run migrate` in the build step instead

# ------------------------------------------- managed: private object store

STORAGE_DRIVER=s3
# Cloudflare R2 (bucket must stay private, no public r2.dev domain, no custom domain)
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
# Backblaze B2 / Scaleway / MinIO / AWS S3 work the same way with their endpoint.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=reviewdesk-uploads
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=              # only for temporary credentials
# S3_FORCE_PATH_STYLE=true       # R2 and MinIO accept path style; S3 accepts both
# S3_KEY_PREFIX=uploads

# ------------------------------------------------------ local development

# DATABASE_URL=pglite://.data/reviewdesk
# STORAGE_DRIVER=filesystem
# UPLOAD_DIR=.data/uploads
# HOST=127.0.0.1
# PORT=4300

# ------------------------------------------------------------- optional

# Vercel caps a serverless request body at 4.5 MB; the default stays under it.
# UPLOAD_MAX_BYTES=4000000
# SESSION_TTL_SECONDS=28800
# SUBMISSIONS_PER_MINUTE=20
# LOGIN_ATTEMPTS_PER_MINUTE=10
# SERVE_STATIC=true              # off automatically on Vercel, where the CDN serves public/
# SECURE_COOKIES=true            # on automatically in production
# LOG_LEVEL=warn
