{
  "name": "reviewdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "npm run build:widget && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && esbuild src/admin/app.ts --bundle --format=iife --outfile=public/admin.js",
    "build:widget": "esbuild src/widget/index.ts --bundle --format=iife --global-name=ReviewDesk --outfile=public/widget.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-concurrency=1 tests/unit/*.test.ts tests/integration/*.test.ts",
    "pretest:e2e": "bash scripts/setup-e2e-deps.sh",
    "test:e2e": "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1 LD_LIBRARY_PATH=.deps/root/usr/lib/x86_64-linux-gnu playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.55.0",
    "@types/node": "22.18.1",
    "esbuild": "0.25.9",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0"
  }
}
